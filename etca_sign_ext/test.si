def get_input($scratch_space: [Int], tick: Int, $inputs: [Int]) {

    inputs[0] = random(31)
    inputs[1] = random(1)

}

def check_output($scratch_space: [Int], tick: Int, inputs: [Int], outputs: [Int]) TestResult {

    let sext = inputs[1]

    let inp = inputs[0] & 0b11111
    let sign = (inp >> 4) & 0b1
    var o = inp
    if (sext == 1) && (sign == 1) {
        o = o | 0b11111111_11100000
    }

    if outputs[0] != o {
        set_error(`Expected {o}.`)
        return fail
    }

    if tick == 0xfff {
        return win
    }

}
