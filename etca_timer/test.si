var next_val = 0
var curr_val = 0

def on_reset($scratch_space: [Int], test: Int) {
    .next_val = 0
    .curr_val = 0
}

def get_input($scratch_space: [Int], tick: Int, $inputs: [Int]) {

    inputs[0] = (random(8) == 0) ? 1 : 0 // Hold
    inputs[1] = (random(8) == 0) ? 1 : 0 // Reset

    .curr_val = .next_val
    if inputs[0] == 0 {
        .next_val = (.curr_val + 1) % 3
    }
    // Reset overrides Hold
    if inputs[1] == 1 {
        .next_val = 0
    }
}

def check_output($scratch_space: [Int], tick: Int, inputs: [Int], outputs: [Int]) TestResult {

    let s1 = outputs[0] // Stage 1
    let s2 = outputs[1] // Stage 2
    let s3 = outputs[2] // Stage 3

    if (s1 + s2 + s3) != 1 {
        set_error(`Exactly one stage has to be high.`)
        return fail
    }
    if outputs[.curr_val] != 1 {
        set_error(`Expected Stage {.curr_val+1}`)
        return fail
    }
    if tick == 0xff {
        return win
    }
}
