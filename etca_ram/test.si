def check_output($scratch_space: [Int], tick: Int, inputs: [Int], outputs: [Int]) TestResult {
    let r0 = get_register_value(0)
    let r1 = get_register_value(1)
    let r2 = get_register_value(2)
    let r4 = get_register_value(4)
    if r4 == 1 {
        if r0 != 2 {
            return fail
        }
        if r1 != 4 {
            return fail
        }
        if r2 != ((-1) & 0xffff) {
            return fail
        }
        return win
    }
    if tick > 255 {
        return fail
    }
}






