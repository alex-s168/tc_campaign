def get_input($scratch_space: [Int], tick: Int, $inputs: [Int]) {

}

def check_output($scratch_space: [Int], tick: Int, inputs: [Int], outputs: [Int]) TestResult {
    let r4 = get_register_value(4)
    if r4 == 1 {
        let r0 = get_register_value(0) // cpuid1
        let r1 = get_register_value(1) // cpuid2
        let r2 = get_register_value(2) // feat
        if r0 != 0 {
            set_error(`cpuid1 should be 0`)
            return fail
        }
        if r1 != 0 {
            set_error(`cpuid2 should be 0`)
            return fail
        }
        if r2 != 0b11 {
            set_error(`feat should be b11`)
            return fail
        }
        return win
    }
    if tick > 255 {
        return fail
    }
}






