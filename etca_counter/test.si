var next_val = 0
var curr_val = 0

def on_reset($scratch_space: [Int], test: Int) {
    .next_val = 0
    .curr_val = 0
}

def get_input($scratch_space: [Int], tick: Int, $inputs: [Int]) {

    inputs[0] = (random(8) == 0) ? 1 : 0 // overwr
    inputs[1] = random(0xffff)

    .curr_val = .next_val
    .next_val = (.curr_val + 2) & 0xffff
    if inputs[0] == 1 {
        .next_val = inputs[1]
    }
}

def check_output($scratch_space: [Int], tick: Int, inputs: [Int], outputs: [Int]) TestResult {

    if outputs[0] != .curr_val {
        set_error(`Expected {.curr_val}.`)
        return fail
    }

    if tick == 0xfff {
        return win
    }

}
